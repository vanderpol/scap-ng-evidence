{
  "$id": "https://scap-ng.dev/schema/v0.4.0/variable-result.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "allOf": [
    {
      "if": {
        "properties": {
          "status": {
            "const": "zero_values"
          }
        },
        "required": [
          "status"
        ]
      },
      "then": {
        "properties": {
          "cardinality": {
            "const": "zero"
          },
          "values": {
            "maxItems": 0
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "status": {
            "enum": [
              "complete",
              "incomplete"
            ]
          }
        },
        "required": [
          "status"
        ]
      },
      "then": {
        "oneOf": [
          {
            "properties": {
              "cardinality": {
                "const": "zero"
              },
              "values": {
                "maxItems": 0
              }
            }
          },
          {
            "properties": {
              "cardinality": {
                "const": "one"
              },
              "values": {
                "maxItems": 1,
                "minItems": 1
              }
            }
          },
          {
            "properties": {
              "cardinality": {
                "const": "many"
              },
              "values": {
                "minItems": 2
              }
            }
          }
        ]
      }
    }
  ],
  "description": "Resolved runtime Variable value set with explicit datatype, cardinality, status, and provenance.",
  "properties": {
    "cardinality": {
      "enum": [
        "zero",
        "one",
        "many"
      ],
      "type": "string"
    },
    "datatype": {
      "description": "OVAL-compatible Variable results are not record-typed; records are collected Item/entity structures.",
      "minLength": 1,
      "not": {
        "const": "record"
      },
      "type": "string"
    },
    "diagnostics": {
      "items": {
        "type": "object"
      },
      "type": "array"
    },
    "id": {
      "minLength": 1,
      "type": "string"
    },
    "item_refs": {
      "description": "Local Items consumed while producing this Variable, including intermediate extraction/filter/selection use.",
      "items": {
        "minLength": 1,
        "type": "string"
      },
      "type": "array",
      "uniqueItems": true
    },
    "provenance": {
      "type": "object"
    },
    "source": {
      "type": [
        "string",
        "null"
      ]
    },
    "status": {
      "description": "Completeness/evaluation status of the resolved Variable value set. 'incomplete' explicitly preserves a partial known value stream; values and cardinality describe only observed values, not a proved total population. It does not establish evaluator propagation precedence.",
      "enum": [
        "complete",
        "incomplete",
        "error",
        "unknown",
        "not_evaluated",
        "not_applicable",
        "zero_values"
      ],
      "type": "string"
    },
    "values": {
      "items": {
        "$ref": "result-types.schema.json#/$defs/typed_value"
      },
      "type": "array"
    },
    "variable_title": {
      "type": [
        "string",
        "null"
      ]
    }
  },
  "required": [
    "id",
    "datatype",
    "status",
    "cardinality",
    "values",
    "item_refs"
  ],
  "title": "SCAP-NG Variable Result draft v0.4.0 strawman",
  "type": "object",
  "x-last-modified": "2026-10-28",
  "x-scap-ng-version": "0.4.0"
}
