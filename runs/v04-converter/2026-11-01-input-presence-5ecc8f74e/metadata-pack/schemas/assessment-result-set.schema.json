{
  "$id": "https://scap-ng.dev/schema/v0.4.0/assessment-result-set.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "Development transport of per-invocation artifacts; not a replacement result package or Benchmark Result.",
  "properties": {
    "assessment_results": {
      "items": {
        "$ref": "assessment-result.schema.json"
      },
      "minItems": 1,
      "type": "array"
    },
    "entry_execution_id": {
      "minLength": 1,
      "type": "string"
    },
    "target_ref": {
      "minLength": 1,
      "type": "string"
    }
  },
  "required": [
    "entry_execution_id",
    "target_ref",
    "assessment_results"
  ],
  "title": "Draft invocation-linked Assessment Results transport",
  "type": "object",
  "x-last-modified": "2026-10-06",
  "x-scap-ng-version": "0.4.0"
}
