    "file_traversal_base": {
      "additionalProperties": false,
      "description": "Shared non-deprecated downward file recursion structure. Traversal direction is fixed by this construct as downward; deprecated OVAL recurse_direction=up is not representable.",
      "properties": {
        "max_depth": {
          "default": "unlimited",
          "description": "Maximum downward recursion depth: 0 means starting directory only, positive integers bound descendant depth, and unlimited has no depth limit. OVAL -1 imports as unlimited.",
          "oneOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "const": "unlimited"
            }
          ],
          "title": "Traversal depth",
          "x-scap-ng-authoring": {
            "aggressive_preview": true,
