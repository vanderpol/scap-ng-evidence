{
  "$id": "https://scap-ng.dev/schema/v0.4.0/rule.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "rule": {
      "additionalProperties": false,
      "properties": {
        "applicability": {
          "type": "array"
        },
        "assessment_choices": {
          "additionalProperties": {
            "additionalProperties": false,
            "properties": {
              "assessment": {
                "minLength": 1,
                "type": "string"
              },
              "expected_version": {
                "description": "Exact logical Assessment version required to disambiguate multiple versions in the declared source scope.",
                "type": [
                  "integer",
                  "string"
                ]
              },
              "inputs": {
                "additionalProperties": {
                  "oneOf": [
                    {
                      "minLength": 1,
                      "type": "string"
                    },
                    {
                      "additionalProperties": false,
                      "properties": {
                        "parameter": {
                          "minLength": 1,
                          "type": "string"
                        }
                      },
                      "required": [
                        "parameter"
                      ],
                      "type": "object"
                    }
                  ]
                },
                "description": "Assessment input name to Benchmark Parameter binding.",
                "type": "object"
              }
            },
            "required": [
              "assessment"
            ],
            "type": "object"
          },
          "description": "Publisher-defined Assessment choices. The redundant source alias named default is prohibited; default_assessment_choice names an actual choice.",
          "minProperties": 1,
          "propertyNames": {
            "not": {
              "const": "default"
            }
          },
          "type": "object"
        },
        "conflicts": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "default_assessment_choice": {
          "minLength": 1,
          "type": "string"
        },
        "discussion": {
          "type": "string"
        },
        "extensions": {
          "type": "object"
        },
        "id": {
          "minLength": 1,
          "type": "string"
        },
        "identifiers": {
          "items": {
            "type": "object"
          },
          "type": "array"
        },
        "organizational_input_requirements": {
          "additionalProperties": {
            "items": {
              "additionalProperties": false,
              "properties": {
                "input": {
                  "minLength": 1,
                  "type": "string"
                },
                "required": {
                  "type": "boolean"
                },
                "uses": {
                  "items": {
                    "additionalProperties": false,
                    "properties": {
                      "state": {
                        "minLength": 1,
                        "type": "string"
                      },
                      "state_slot": {
                        "minLength": 1,
                        "type": "string"
                      },
                      "test": {
                        "minLength": 1,
                        "type": "string"
                      }
                    },
                    "required": [
                      "test",
                      "state",
                      "state_slot"
                    ],
                    "type": "object"
                  },
                  "minItems": 1,
                  "type": "array"
                }
              },
              "required": [
                "input",
                "required",
                "uses"
              ],
              "type": "object"
            },
            "type": "array"
          },
          "description": "Rule-level discoverability map of Organizational Input dependencies by Assessment choice. Always present; empty when no choice depends on Organizational Input. Technical use locations are identified by Test, State, and State slot.",
          "type": "object"
        },
        "parameters": {
          "type": "object"
        },
        "rationale": {
          "type": [
            "string",
            "null"
          ]
        },
        "references": {
          "items": {
            "type": "object"
          },
          "type": "array"
        },
        "remediation": {
          "type": "object"
        },
        "requires": {
          "description": "Selection prerequisites. Each array entry is one requirement clause; clauses are ANDed. A clause's any_of members are ORed. A single string is shorthand for a one-member clause.",
          "items": {
            "oneOf": [
              {
                "minLength": 1,
                "type": "string"
              },
              {
                "additionalProperties": false,
                "properties": {
                  "any_of": {
                    "items": {
                      "minLength": 1,
                      "type": "string"
                    },
                    "minItems": 1,
                    "type": "array",
                    "uniqueItems": true
                  }
                },
                "required": [
                  "any_of"
                ],
                "type": "object"
              }
            ]
          },
          "type": "array"
        },
        "role": {
          "type": "string"
        },
        "severity": {
          "type": "string"
        },
        "title": {
          "type": "string"
        },
        "version": {
          "type": "string"
        },
        "warnings": {
          "type": "array"
        },
        "weight": {
          "type": "number"
        }
      },
      "required": [
        "id",
        "version",
        "title",
        "severity",
        "role",
        "weight",
        "requires",
        "conflicts",
        "applicability",
        "parameters",
        "organizational_input_requirements",
        "assessment_choices",
        "default_assessment_choice"
      ],
      "type": "object"
    }
  },
  "required": [
    "rule"
  ],
  "title": "SCAP-NG Rule v0.4.0",
  "type": "object",
  "x-last-modified": "2026-10-31",
  "x-scap-ng-version": "0.4.0"
}
