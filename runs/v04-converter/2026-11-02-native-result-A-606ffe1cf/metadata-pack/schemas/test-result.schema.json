{
  "$id": "https://scap-ng.dev/schema/v0.4.0/test-result.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "allOf": [
    {
      "if": {
        "properties": {
          "outcome": {
            "const": "error"
          }
        },
        "required": [
          "outcome"
        ]
      },
      "then": {
        "properties": {
          "evidence_refs": {
            "items": {
              "minLength": 1,
              "pattern": "\\S",
              "type": "string"
            },
            "minItems": 1,
            "type": "array",
            "uniqueItems": true
          }
        },
        "required": [
          "reason",
          "evidence_refs"
        ]
      }
    }
  ],
  "description": "Test-centered supplied observations with source-bound native requirements. No OVAL check aliases or synthetic State positions.",
  "properties": {
    "binding_set_id": {
      "pattern": "^[0-9a-f]{64}$",
      "type": "string"
    },
    "decisive_require_refs": {
      "items": {
        "description": "Canonical RFC6901 location in the owning Assessment; semantic validation must resolve it to a requirement node of this Test.",
        "pattern": "^/tests/(?:[^~/]|~[01])+/require(?:/(?:[^~]|~[01])*)?$",
        "type": "string"
      },
      "type": "array",
      "uniqueItems": true
    },
    "evidence_refs": {
      "items": {
        "minLength": 1,
        "pattern": "\\S",
        "type": "string"
      },
      "type": "array",
      "uniqueItems": true
    },
    "existence_outcome": {
      "oneOf": [
        {
          "$ref": "result-types.schema.json#/$defs/technical_outcome"
        },
        {
          "type": "null"
        }
      ]
    },
    "field_requirement": {
      "$ref": "assessment-language.schema.json#/$defs/paired_requirement"
    },
    "id": {
      "minLength": 1,
      "type": "string"
    },
    "invocation_ref": {
      "minLength": 1,
      "pattern": "\\S",
      "type": "string"
    },
    "item_refs": {
      "description": "Only the collected Item IDs retained under per_item_results or otherwise needed to explain the Test. This list is not an unbounded enumeration of every evaluated Item; the required item_summary provides evaluated, failing and retained counts when reporting is capped.",
      "items": {
        "type": "string"
      },
      "type": "array"
    },
    "item_summary": {
      "additionalProperties": false,
      "description": "Required counts for every technical Test, including no-item, unknown and capped-evidence cases. Evaluated Items and mismatches describe execution; returned_items counts retained per_item_results; actual_mismatches is unknown if full relevant population was not evaluated. Consistency between these values, the assessment retention cap and retained Items SHALL be validated beyond JSON Schema.",
      "properties": {
        "actual_mismatches": {
          "oneOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "const": "unknown"
            }
          ]
        },
        "evaluated_items": {
          "minimum": 0,
          "type": "integer"
        },
        "observed_mismatches": {
          "minimum": 0,
          "type": "integer"
        },
        "returned_items": {
          "minimum": 0,
          "type": "integer"
        },
        "truncated_evidence": {
          "type": "boolean"
        }
      },
      "required": [
        "evaluated_items",
        "observed_mismatches",
        "actual_mismatches",
        "returned_items",
        "truncated_evidence"
      ],
      "type": "object"
    },
    "items_found": {
      "$ref": "assessment-language.schema.json#/$defs/item_existence_cardinality"
    },
    "items_observed": {
      "description": "Explicit observed Item population, independent from evaluated/retained counts. Never infer zero from an empty reporting projection.",
      "oneOf": [
        {
          "minimum": 0,
          "type": "integer"
        },
        {
          "const": "unknown"
        }
      ]
    },
    "items_satisfying": {
      "$ref": "assessment-language.schema.json#/$defs/cardinality"
    },
    "object_refs": {
      "items": {
        "type": "string"
      },
      "type": "array"
    },
    "outcome": {
      "$ref": "result-types.schema.json#/$defs/technical_outcome"
    },
    "per_item_results": {
      "description": "Test-local reported system Items and their evaluated State/Entity comparisons, subject to scanner-controlled evidence retention. This array can be a sample; never infer counts or collection completeness from its length.",
      "items": {
        "additionalProperties": false,
        "allOf": [
          {
            "if": {
              "properties": {
                "outcome": {
                  "const": "error"
                }
              },
              "required": [
                "outcome"
              ]
            },
            "then": {
              "properties": {
                "evidence_refs": {
                  "items": {
                    "minLength": 1,
                    "pattern": "\\S",
                    "type": "string"
                  },
                  "minItems": 1,
                  "type": "array",
                  "uniqueItems": true
                }
              },
              "required": [
                "reason",
                "evidence_refs"
              ]
            }
          }
        ],
        "properties": {
          "evidence_refs": {
            "items": {
              "minLength": 1,
              "pattern": "\\S",
              "type": "string"
            },
            "type": "array",
            "uniqueItems": true
          },
          "item": {
            "$ref": "collected-item.schema.json",
            "description": "Retained system Item beside the verdict and native requirement observations; its id must equal item_ref. No synthetic missing Item."
          },
          "item_ref": {
            "minLength": 1,
            "type": "string"
          },
          "outcome": {
            "$ref": "result-types.schema.json#/$defs/technical_outcome"
          },
          "reason": {
            "minLength": 1,
            "pattern": "\\S",
            "type": "string"
          },
          "require_results": {
            "items": {
              "$ref": "require-result.schema.json"
            },
            "type": "array"
          }
        },
        "required": [
          "item_ref",
          "outcome",
          "require_results",
          "item"
        ],
        "type": "object"
      },
      "type": "array"
    },
    "reason": {
      "minLength": 1,
      "pattern": "\\S",
      "type": "string"
    },
    "require_refs": {
      "items": {
        "description": "Canonical RFC6901 location in the owning Assessment; semantic validation must resolve it to a requirement node of this Test.",
        "pattern": "^/tests/(?:[^~/]|~[01])+/require(?:/(?:[^~]|~[01])*)?$",
        "type": "string"
      },
      "minItems": 1,
      "type": "array",
      "uniqueItems": true
    },
    "test_title": {
      "type": [
        "string",
        "null"
      ]
    }
  },
  "required": [
    "id",
    "outcome",
    "object_refs",
    "item_refs",
    "per_item_results",
    "item_summary",
    "invocation_ref",
    "require_refs",
    "items_found",
    "items_observed"
  ],
  "title": "Native 0.4 Test Result",
  "type": "object",
  "x-last-modified": "2026-11-02",
  "x-scap-ng-version": "0.4.0"
}
