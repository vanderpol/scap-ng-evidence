{
  "$id": "https://scap-ng.dev/schema/v0.4.0/manual-assessment.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "Disposable high-level schema for simple, traceable human determinations. Intentionally avoids OCIL-style questionnaire/workflow graphs.",
  "properties": {
    "assessment": {
      "additionalProperties": false,
      "properties": {
        "assessment_title": {
          "type": [
            "string",
            "null"
          ]
        },
        "class": {
          "enum": [
            "compliance",
            "vulnerability",
            "patch",
            "inventory",
            "miscellaneous"
          ],
          "type": "string"
        },
        "evidence_guidance": {
          "type": [
            "string",
            "null"
          ]
        },
        "id": {
          "maxLength": 64,
          "minLength": 1,
          "type": "string"
        },
        "mode": {
          "const": "manual"
        },
        "procedure": {
          "minLength": 1,
          "type": "string"
        },
        "references": {
          "items": {
            "type": "object"
          },
          "type": "array"
        },
        "response": {
          "additionalProperties": false,
          "description": "Small human-response contract. UI labels are separate from normalized SCAP-NG outcomes.",
          "properties": {
            "allow_comment": {
              "type": "boolean"
            },
            "allow_evidence": {
              "type": "boolean"
            },
            "choices": {
              "items": {
                "additionalProperties": false,
                "properties": {
                  "label": {
                    "type": [
                      "string",
                      "null"
                    ]
                  },
                  "outcome": {
                    "enum": [
                      "true",
                      "false",
                      "error",
                      "unknown",
                      "not_evaluated",
                      "not_applicable"
                    ],
                    "type": "string"
                  },
                  "value": {
                    "minLength": 1,
                    "type": "string"
                  }
                },
                "required": [
                  "value",
                  "outcome"
                ],
                "type": "object"
              },
              "minItems": 1,
              "type": "array"
            },
            "type": {
              "description": "Publisher-defined or standardized response vocabulary identifier.",
              "minLength": 1,
              "type": "string"
            }
          },
          "required": [
            "type",
            "choices",
            "allow_comment",
            "allow_evidence"
          ],
          "type": "object"
        },
        "version": {
          "type": [
            "integer",
            "string"
          ]
        }
      },
      "required": [
        "id",
        "version",
        "assessment_title",
        "mode",
        "class",
        "procedure",
        "response"
      ],
      "type": "object"
    }
  },
  "required": [
    "assessment"
  ],
  "title": "SCAP-NG Manual Assessment v0.4.0 high-level draft",
  "type": "object",
  "x-last-modified": "2026-10-31",
  "x-scap-ng-version": "0.4.0"
}
