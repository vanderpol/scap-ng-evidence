{
  "$id": "https://scap-ng.dev/schema/v0.4.0/collection-result.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "allOf": [
    {
      "if": {
        "properties": {
          "status": {
            "enum": [
              "error",
              "incomplete"
            ]
          }
        },
        "required": [
          "status"
        ]
      },
      "then": {
        "properties": {
          "diagnostics": {
            "items": {
              "properties": {
                "code": {
                  "minLength": 1,
                  "pattern": "\\S",
                  "type": "string"
                },
                "message": {
                  "minLength": 1,
                  "pattern": "\\S",
                  "type": "string"
                }
              },
              "required": [
                "code",
                "message"
              ],
              "type": "object"
            },
            "minItems": 1,
            "type": "array"
          },
          "stop_reason": {
            "minLength": 1,
            "pattern": "\\S",
            "type": "string"
          }
        },
        "required": [
          "stop_reason",
          "diagnostics"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "status": {
            "const": "incomplete"
          }
        },
        "required": [
          "status"
        ]
      },
      "then": {
        "properties": {
          "population_complete": {
            "const": false
          }
        },
        "required": [
          "population_complete"
        ]
      }
    }
  ],
  "description": "Runtime result of evaluating an authored Object and producing Items. Collection status is intentionally not Boolean.",
  "properties": {
    "capability": {
      "minLength": 1,
      "type": "string"
    },
    "diagnostics": {
      "items": {
        "type": "object"
      },
      "type": "array"
    },
    "id": {
      "minLength": 1,
      "type": "string"
    },
    "item_refs": {
      "description": "Identities of Items retained or materially referenced in this result. An evidence cap SHALL NOT require enumeration of every collected Item ID; evaluated population and truncation are reported via Assessment/Test summary and collection completeness.",
      "items": {
        "type": "string"
      },
      "type": "array"
    },
    "logical_complete": {
      "type": [
        "boolean",
        "null"
      ]
    },
    "object_title": {
      "type": [
        "string",
        "null"
      ]
    },
    "population_complete": {
      "type": [
        "boolean",
        "null"
      ]
    },
    "source_execution_ref": {
      "type": [
        "string",
        "null"
      ]
    },
    "status": {
      "enum": [
        "error",
        "complete",
        "incomplete",
        "does_not_exist",
        "not_collected",
        "not_applicable"
      ],
      "type": "string"
    },
    "stop_reason": {
      "type": [
        "string",
        "null"
      ]
    }
  },
  "required": [
    "id",
    "capability",
    "status",
    "item_refs"
  ],
  "title": "SCAP-NG Object Collection Result draft v0.4.0 strawman",
  "type": "object",
  "x-last-modified": "2026-11-02",
  "x-scap-ng-version": "0.4.0"
}
