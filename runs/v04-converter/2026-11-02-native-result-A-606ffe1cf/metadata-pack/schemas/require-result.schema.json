{
  "$id": "https://scap-ng.dev/schema/v0.4.0/require-result.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "allOf": [
    {
      "if": {
        "properties": {
          "outcome": {
            "const": "error"
          }
        },
        "required": [
          "outcome"
        ]
      },
      "then": {
        "properties": {
          "evidence_refs": {
            "items": {
              "minLength": 1,
              "pattern": "\\S",
              "type": "string"
            },
            "minItems": 1,
            "type": "array",
            "uniqueItems": true
          }
        },
        "required": [
          "reason",
          "evidence_refs"
        ]
      }
    }
  ],
  "description": "Technical observation at one native Test/group/record/field location; record_ref preserves per-record correlation. Source OVAL identities belong only in migration provenance.",
  "properties": {
    "evidence_refs": {
      "items": {
        "minLength": 1,
        "pattern": "\\S",
        "type": "string"
      },
      "type": "array",
      "uniqueItems": true
    },
    "field_results": {
      "items": {
        "$ref": "field-result.schema.json"
      },
      "type": "array"
    },
    "observation_complete": {
      "description": "Explicit supplied completeness for record absence; never inferred from missing retained values.",
      "type": "boolean"
    },
    "operator": {
      "enum": [
        "and",
        "or",
        "one",
        "xor"
      ]
    },
    "outcome": {
      "$ref": "result-types.schema.json#/$defs/technical_outcome"
    },
    "reason": {
      "minLength": 1,
      "pattern": "\\S",
      "type": "string"
    },
    "record_ref": {
      "description": "Canonical RFC6901 pointer into the retained Item to this exact typed record instance, including array index when multivalued.",
      "pattern": "^/fields/(?:[^~]|~[01])+$",
      "type": "string"
    },
    "records_found": {
      "$ref": "assessment-language.schema.json#/$defs/existence_cardinality"
    },
    "records_matching": {
      "$ref": "assessment-language.schema.json#/$defs/cardinality"
    },
    "require_ref": {
      "description": "Canonical RFC6901 location in the owning Assessment; semantic validation must resolve it to a requirement node of this Test.",
      "pattern": "^/tests/(?:[^~/]|~[01])+/require(?:/(?:[^~]|~[01])*)?$",
      "type": "string"
    },
    "require_results": {
      "items": {
        "$ref": "require-result.schema.json"
      },
      "type": "array"
    }
  },
  "required": [
    "require_ref",
    "outcome",
    "field_results"
  ],
  "title": "Native 0.4 requirement Result",
  "type": "object",
  "x-last-modified": "2026-11-02",
  "x-scap-ng-version": "0.4.0"
}
