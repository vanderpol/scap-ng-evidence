{
  "$defs": {
    "integrity": {
      "additionalProperties": false,
      "properties": {
        "algorithm": {
          "const": "sha-256"
        },
        "unexpected_members": {
          "const": "reject"
        }
      },
      "required": [
        "algorithm",
        "unexpected_members"
      ],
      "type": "object"
    },
    "object_record": {
      "additionalProperties": false,
      "properties": {
        "path": {
          "maxLength": 160,
          "minLength": 1,
          "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))(?![A-Za-z]:)[^\\\\]+$",
          "type": "string"
        },
        "sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "type": "string"
        },
        "size": {
          "minimum": 0,
          "type": "integer"
        },
        "type": {
          "enum": [
            "benchmark",
            "rule",
            "assessment",
            "applicability_catalog"
          ]
        },
        "version": {}
      },
      "required": [
        "type",
        "version",
        "path",
        "sha256",
        "size"
      ],
      "type": "object"
    },
    "signature": {
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "format": {
                "type": "string"
              }
            },
            "required": [
              "format"
            ]
          },
          "then": {
            "properties": {
              "certificate_path": {
                "minLength": 1,
                "type": "string"
              },
              "format": {
                "const": "cms-detached-der"
              },
              "path": {
                "minLength": 1,
                "type": "string"
              },
              "trust": {
                "minLength": 1,
                "type": "string"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "format": {
                "type": "null"
              }
            },
            "required": [
              "format"
            ]
          },
          "then": {
            "properties": {
              "certificate_path": {
                "type": "null"
              },
              "path": {
                "type": "null"
              },
              "trust": {
                "type": "null"
              }
            }
          }
        }
      ],
      "properties": {
        "certificate_path": {
          "type": [
            "string",
            "null"
          ]
        },
        "format": {
          "type": [
            "string",
            "null"
          ]
        },
        "path": {
          "type": [
            "string",
            "null"
          ]
        },
        "trust": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "format",
        "path",
        "certificate_path",
        "trust"
      ],
      "type": "object"
    }
  },
  "$id": "https://scap-ng.dev/schema/v0.4.0/package-manifest.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "Pre-alpha manifest for the SCAP-NG logical object graph. Container member paths are storage bindings only; logical IDs are authoritative.",
  "properties": {
    "benchmark_id": {
      "minLength": 1,
      "type": "string"
    },
    "benchmark_version": {},
    "build_provenance": {
      "type": "object"
    },
    "entrypoint": {
      "minLength": 1,
      "type": "string"
    },
    "format": {
      "const": "scap-ng-package-manifest"
    },
    "format_version": {
      "minLength": 1,
      "type": "string"
    },
    "integrity": {
      "$ref": "#/$defs/integrity"
    },
    "objects": {
      "additionalProperties": {
        "$ref": "#/$defs/object_record"
      },
      "minProperties": 1,
      "propertyNames": {
        "minLength": 1,
        "type": "string"
      },
      "type": "object"
    },
    "signature": {
      "$ref": "#/$defs/signature"
    }
  },
  "required": [
    "format",
    "format_version",
    "benchmark_id",
    "benchmark_version",
    "entrypoint",
    "objects",
    "integrity",
    "build_provenance",
    "signature"
  ],
  "title": "SCAP-NG package manifest v0.4.0",
  "type": "object",
  "x-last-modified": "2026-10-06",
  "x-scap-ng-version": "0.4.0"
}
