{
  "$id": "https://scap-ng.dev/schema/v0.4.0/manual-assessment-result.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "Disposable high-level schema for a self-contained manual determination and its provenance.",
  "properties": {
    "manual_assessment_result": {
      "additionalProperties": false,
      "properties": {
        "answer": {
          "description": "Exact response value selected or supplied under the Manual Assessment response contract.",
          "type": [
            "string",
            "number",
            "integer",
            "boolean",
            "null"
          ]
        },
        "answer_label": {
          "type": [
            "string",
            "null"
          ]
        },
        "assessment": {
          "additionalProperties": false,
          "properties": {
            "digest": {
              "type": [
                "string",
                "null"
              ]
            },
            "id": {
              "minLength": 1,
              "type": "string"
            },
            "version": {
              "type": [
                "integer",
                "string"
              ]
            }
          },
          "required": [
            "id",
            "version"
          ],
          "type": "object"
        },
        "comment": {
          "type": [
            "string",
            "null"
          ]
        },
        "completed_at": {
          "format": "date-time",
          "type": "string"
        },
        "evaluator": {
          "additionalProperties": false,
          "properties": {
            "display_name": {
              "type": [
                "string",
                "null"
              ]
            },
            "id": {
              "additionalProperties": false,
              "properties": {
                "scheme": {
                  "minLength": 1,
                  "type": "string"
                },
                "value": {
                  "minLength": 1,
                  "type": "string"
                }
              },
              "required": [
                "scheme",
                "value"
              ],
              "type": "object"
            },
            "identity_source": {
              "type": [
                "string",
                "null"
              ]
            },
            "organization": {
              "type": [
                "string",
                "null"
              ]
            },
            "organizational_unit": {
              "type": [
                "string",
                "null"
              ]
            },
            "role": {
              "type": [
                "string",
                "null"
              ]
            }
          },
          "required": [
            "id"
          ],
          "type": "object"
        },
        "evidence_refs": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "execution_id": {
          "minLength": 1,
          "type": "string"
        },
        "import_provenance": {
          "type": [
            "object",
            "null"
          ]
        },
        "outcome": {
          "enum": [
            "true",
            "false",
            "error",
            "unknown",
            "not_evaluated",
            "not_applicable"
          ],
          "type": "string"
        },
        "procedure_snapshot": {
          "description": "Optional snapshot when required for durable audit; normally source identity/digest is sufficient.",
          "type": [
            "string",
            "null"
          ]
        },
        "response_source": {
          "enum": [
            "direct",
            "imported",
            "delegated"
          ],
          "type": "string"
        },
        "result_schema_version": {
          "minLength": 1,
          "type": "string"
        },
        "review": {
          "type": [
            "object",
            "null"
          ]
        },
        "started_at": {
          "format": "date-time",
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "result_schema_version",
        "execution_id",
        "assessment",
        "answer",
        "outcome",
        "completed_at",
        "response_source",
        "evaluator"
      ],
      "type": "object"
    }
  },
  "required": [
    "manual_assessment_result"
  ],
  "title": "SCAP-NG Manual Assessment Result v0.4.0 high-level draft",
  "type": "object",
  "x-last-modified": "2026-10-06",
  "x-scap-ng-version": "0.4.0"
}
