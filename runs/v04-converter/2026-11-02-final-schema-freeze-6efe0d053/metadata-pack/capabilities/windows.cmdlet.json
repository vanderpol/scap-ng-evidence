        },
        "module_id": {
          "description": "PowerShell module GUID; null preserves source xsi:nil meaning that module GUID is unconstrained. Decision22 selection/API contract: A supplied module GUID constrains module identity, not culture-sensitive text. Preserve its lexical form and let the documented module specification parse/resolve it; null retains the existing unconstrained meaning. Do not invent a module from an invalid GUID. Collected-value comparisons remain independent. Sources: https://learn.microsoft.com/en-us/powershell/module/microsoft.powershell.core/import-module?view=powershell-7.6",
          "oneOf": [
            {
              "description": "PowerShell module GUID; null preserves source xsi:nil meaning that module GUID is unconstrained.",
              "type": "string"
            },
            {
              "$ref": "https://scap-ng.dev/schema/v0.4.0/capability-common.schema.json#/$defs/variable_reference"
            },
            {
              "type": "null"
            }
          ]
        },
        "module_name": {
          "description": "PowerShell module name; null preserves source xsi:nil meaning that module name is unconstrained. Decision22 selection/API contract: PowerShell module/command names are insensitive where PowerShell defines them. Preserve canonical native verb enum spelling, which remains exact in YAML. Module filesystem discovery must honor target path rules. Null module_name leaves that existing source constraint unconstrained, never selects a fallback. Collected-value comparisons remain independent. Sources: https://learn.microsoft.com/en-us/powershell/module/microsoft.powershell.core/about/about_case-sensitivity?view=powershell-7.6 https://learn.microsoft.com/en-us/powershell/module/microsoft.powershell.core/import-module?view=powershell-7.6",
          "oneOf": [
            {
              "description": "PowerShell module name; null preserves source xsi:nil meaning that module name is unconstrained.",
              "type": "string"
            },
            {
              "$ref": "https://scap-ng.dev/schema/v0.4.0/capability-common.schema.json#/$defs/variable_reference"
            },
            {
              "type": "null"
            }
          ]
        },
        "module_version": {
          "description": "Quoted lexical version value; type is inferred as version from this native capability contract. No author datatype needed. Reject non-version inputs rather than converting arbitrary strings. Null preserves source xsi:nil meaning that module version is unconstrained. State comparison version semantics remain distinct. Decision22 selection/API contract: The existing version domain applies, not string casing or lexicographic order; preserve explicit lexical version and null unconstrained meaning. Do not infer case rules for filenames or rewrite version operands. Collected-value comparisons remain independent. Sources: https://learn.microsoft.com/en-us/powershell/module/microsoft.powershell.core/import-module?view=powershell-7.6",
          "oneOf": [
            {
              "description": "Quoted lexical version value; type is inferred as version from this native capability contract. No author datatype needed. Reject non-version inputs rather than converting arbitrary strings. Null preserves source xsi:nil meaning that module version is unconstrained. State comparison version semantics remain distinct.",
              "pattern": "^[0-9]+(?:[^0-9][0-9]+)*$",
              "type": "string",
              "x-scap-ng-semantic-datatype": "version"
            },
            {
              "$ref": "https://scap-ng.dev/schema/v0.4.0/capability-common.schema.json#/$defs/variable_reference"
            },
            {
              "type": "null"
            }
          ]
        },
        "noun": {
          "description": "PowerShell cmdlet noun. Decision22 selection/API contract: PowerShell module/command names are insensitive where PowerShell defines them. Preserve canonical native verb enum spelling, which remains exact in YAML. Module filesystem discovery must honor target path rules. Null module_name leaves that existing source constraint unconstrained, never selects a fallback. Collected-value comparisons remain independent. Sources: https://learn.microsoft.com/en-us/powershell/module/microsoft.powershell.core/about/about_case-sensitivity?view=powershell-7.6 https://learn.microsoft.com/en-us/powershell/module/microsoft.powershell.core/import-module?view=powershell-7.6",
          "oneOf": [
            {
              "description": "PowerShell cmdlet noun.",
              "type": "string"
            },
            {
              "$ref": "https://scap-ng.dev/schema/v0.4.0/capability-common.schema.json#/$defs/variable_reference"
            }
          ]
        },
        "object_title": {
          "description": "Human-readable name of this collection source. It does not select targets or change collection results.",
          "type": [
            "string",
            "null"
          ]
        },
        "parameters": {
          "description": "Named cmdlet invocation parameters; null means no parameters are supplied. Decision22 selection/API contract: Treat record member names as named cmdlet parameters for parameters, and selected output property names for select. PowerShell parameter names/non-dictionary members are insensitive; arbitrary nested dictionary keys, calculated expressions and parameter values are opaque cmdlet/provider data and retain their own comparer. Null means no supplied record, not implicit arguments. Collected-value comparisons remain independent. Sources: https://learn.microsoft.com/en-us/powershell/module/microsoft.powershell.core/about/about_case-sensitivity?view=powershell-7.6 https://learn.microsoft.com/en-us/powershell/module/microsoft.powershell.utility/select-object?view=powershell-7.6",
          "oneOf": [
            {
              "$ref": "https://scap-ng.dev/schema/v0.4.0/capability-common.schema.json#/$defs/object_record",
              "description": "Named cmdlet invocation parameters; null means no parameters are supplied."
            },
            {
              "type": "null"
            }
          ]
        },
        "select": {
          "description": "Named output properties selected from the cmdlet result; null means Select-Object is not used. Decision22 selection/API contract: Treat record member names as named cmdlet parameters for parameters, and selected output property names for select. PowerShell parameter names/non-dictionary members are insensitive; arbitrary nested dictionary keys, calculated expressions and parameter values are opaque cmdlet/provider data and retain their own comparer. Null means no supplied record, not implicit arguments. Collected-value comparisons remain independent. Sources: https://learn.microsoft.com/en-us/powershell/module/microsoft.powershell.core/about/about_case-sensitivity?view=powershell-7.6 https://learn.microsoft.com/en-us/powershell/module/microsoft.powershell.utility/select-object?view=powershell-7.6",
          "oneOf": [
            {
              "$ref": "https://scap-ng.dev/schema/v0.4.0/capability-common.schema.json#/$defs/object_record",
              "description": "Named output properties selected from the cmdlet result; null means Select-Object is not used."
            },
            {
              "type": "null"
            }
          ]
        },
        "set": {
          "$ref": "https://scap-ng.dev/schema/v0.4.0/generated/capabilities/windows.cmdlet.schema.json#/$defs/native_set_expression",
          "description": "Acquire a collection through explicit Object Set operands and ordered per-operand filters. Set membership is distinct from Test truth aggregation."
        },
        "verb": {
          "description": "PowerShell cmdlet verb. Decision22 selection/API contract: PowerShell module/command names are insensitive where PowerShell defines them. Preserve canonical native verb enum spelling, which remains exact in YAML. Module filesystem discovery must honor target path rules. Null module_name leaves that existing source constraint unconstrained, never selects a fallback. Collected-value comparisons remain independent. Sources: https://learn.microsoft.com/en-us/powershell/module/microsoft.powershell.core/about/about_case-sensitivity?view=powershell-7.6 https://learn.microsoft.com/en-us/powershell/module/microsoft.powershell.core/import-module?view=powershell-7.6",
          "oneOf": [
            {
              "description": "PowerShell cmdlet verb.",
              "enum": [
                "Approve",
                "Assert",
                "Compare",
                "Confirm",
                "Find",
                "Get",
                "Import",
                "Measure",
                "Read",
                "Request",
                "Resolve",
                "Search",
                "Select",
                "Show",
                "Test",
                "Trace",
                "Watch"
              ],
              "type": "string"
            },
            {
              "$ref": "https://scap-ng.dev/schema/v0.4.0/capability-common.schema.json#/$defs/variable_reference"
            }
          ]
        }
      },
