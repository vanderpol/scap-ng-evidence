        },
        "include_default": {
          "default": false,
          "description": "Whether the local Default user's ntuser.dat is included. OVAL default false is materialized explicitly. 'include_default' defines if the Window's local Default ntuser.dat file is included in the results. By default, this file is not included in the results. The Default User's directory which contains the ntuser.dat file is stored in the registry at 'HKEY_LOCAL_MACHINE/SOFTWARE/Microsoft/Windows NT/CurrentVersion/ProfileList/Default'. New authoring saves this selection explicitly. Source conversion preserves actual/effective values; this is acquisition behavior, not a Test result. Decision22 selection/API contract: Include the local Default user profile hive only when explicitly enabled. It is an explicit Boolean, not a case policy or hidden runtime default. Collected-value comparisons remain independent. Sources: https://learn.microsoft.com/en-us/windows/win32/sysinfo/registry-hives https://github.com/vanderpol/scap-ng/blob/606ffe1cf/third_party/scap-1.4-schemas/oval_5.12.3/windows-definitions-schema.xsd",
          "title": "Collection include default",
          "type": "boolean",
          "x-scap-ng-authoring": {
            "aggressive_preview": false,
            "authority": "https://github.com/vanderpol/scap-ng/issues/269",
            "context": "capability_object",
            "control_id": "collection_include_default",
            "group": "acquisition",
            "hide_when_default": true,
            "new_authoring_only": true,
            "oval_source": [
              {
                "attribute": "include_default",
                "declaration_context": [
                  "NTUserBehaviors"
                ],
                "declaration_kind": "attribute",
                "documentation": "'include_default' defines if the Window's local Default ntuser.dat file is included in the results. By default, this file is not included in the results. The Default User's directory which contains the ntuser.dat file is stored in the registry at 'HKEY_LOCAL_MACHINE/SOFTWARE/Microsoft/Windows NT/CurrentVersion/ProfileList/Default'.",
                "omission": "Use effective default after occurrence/restriction resolution; not native editor authority",
                "origin": "XSD_DECLARED_DEFAULT",
                "oval_qname": "{http://oval.mitre.org/XMLSchema/oval-definitions-5#windows}NTUserBehaviors/@include_default",
                "reachability_limit": "QName dependency census; occurrence-specific overrides require review",
                "source_default": "false",
                "source_line": 4206,
                "source_path": "third_party/scap-1.4-schemas/oval_5.12.3/windows-definitions-schema.xsd",
                "source_sha256": "b66f1547bfd0bb8ea6cf58a0eec9f8de417aad6642f741d0ed0ad7b6462314ff",
                "source_type": "xsd:boolean",
                "source_xpath": "/xsd:schema/xsd:complexType[7]/xsd:attribute[1]"
              }
            ],
            "preserve_overrides": true,
            "representation": "value",
            "serialize_explicitly": true,
            "version": 1
          }
        },
        "item_creation": {
          "default": "key_and_name_exist",
          "description": "Controls whether Items are created only for matching key/name pairs or for every relevant ntuser.dat. OVAL default key_and_name_exist is materialized explicitly. For 'key_and_name_exist', items are only created when an ntuser.dat file includes the key and name provided in the ntuser object. For 'every_ntuser', items are created for each relavent ntuser.dat found on the system. This option will prevent false negatives in instances where each ntuser.dat file must contain the required key/name/value in order to pass, but the file is lacking the key/name required to normally satisfy the creation of an ntuser item. New authoring saves this selection explicitly. Source conversion preserves actual/effective values; this is acquisition behavior, not a Test result. Decision22 selection/API contract: Use exact existing key_and_name_exist/every_ntuser tokens. These choose the source acquisition population; they do not authorize fabricated Items or make failed hive reads into absence. Collected-value comparisons remain independent. Sources: https://learn.microsoft.com/en-us/windows/win32/sysinfo/registry-hives https://github.com/vanderpol/scap-ng/blob/606ffe1cf/third_party/scap-1.4-schemas/oval_5.12.3/windows-definitions-schema.xsd",
          "enum": [
            "key_and_name_exist",
            "every_ntuser"
          ],
          "title": "Collection item creation key and name exist",
          "type": "string",
          "x-scap-ng-authoring": {
            "aggressive_preview": false,
            "authority": "https://github.com/vanderpol/scap-ng/issues/269",
            "context": "capability_object",
            "control_id": "collection_item_creation_key_and_name_exist",
