                "declaration_kind": "attribute",
                "documentation": "For 'key_and_name_exist', items are only created when an ntuser.dat file includes the key and name provided in the ntuser object. For 'every_ntuser', items are created for each relavent ntuser.dat found on the system. This option will prevent false negatives in instances where each ntuser.dat file must contain the required key/name/value in order to pass, but the file is lacking the key/name required to normally satisfy the creation of an ntuser item.",
                "omission": "Use effective default after occurrence/restriction resolution; not native editor authority",
                "origin": "XSD_DECLARED_DEFAULT",
                "oval_qname": "{http://oval.mitre.org/XMLSchema/oval-definitions-5#windows}NTUserBehaviors/@item_creation",
                "reachability_limit": "QName dependency census; occurrence-specific overrides require review",
                "source_default": "key_and_name_exist",
                "source_line": 4276,
                "source_path": "third_party/scap-1.4-schemas/oval_5.12.3/windows-definitions-schema.xsd",
                "source_sha256": "b66f1547bfd0bb8ea6cf58a0eec9f8de417aad6642f741d0ed0ad7b6462314ff",
                "source_type": null,
                "source_xpath": "/xsd:schema/xsd:complexType[7]/xsd:attribute[5]"
              }
            ],
            "preserve_overrides": true,
            "representation": "value",
            "serialize_explicitly": true,
            "version": 1
          }
